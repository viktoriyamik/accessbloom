# Copy to .env and load via systemd EnvironmentFile (shell: set -a; source .env; set +a)
PORT=4117
HOST=127.0.0.1
BASE_PATH=/accessbloom
DATA_DIR=/opt/accessbloom/data
# Secret protects real scans, stored report history, and review edits. Generate: openssl rand -hex 32
SCAN_ACCESS_TOKEN=replace-with-long-random-value
# Public demo is always available, real scans are owner-only.
SCAN_ALLOWED_HOSTS=vik.ooo,haesiivooja.fi
MAX_SCAN_PER_HOUR=20
# Optional AI analysis. Never expose this key to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=true
